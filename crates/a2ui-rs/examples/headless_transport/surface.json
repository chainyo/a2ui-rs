{
  "version": "1.0",
  "createSurface": {
    "surfaceId": "shipment",
    "catalogId": "https://example.com/shipment-catalog.json",
    "dataModel": { "destination": "London" },
    "components": [
      {
        "id": "root",
        "component": "Shipment",
        "estimate": {
          "@call": "estimateDelivery",
          "args": { "destination": { "@path": "/destination" } }
        },
        "action": {
          "event": {
            "name": "confirmDestination",
            "context": { "destination": { "@path": "/destination" } }
          }
        }
      }
    ]
  }
}
