{
  "catalog": {
    "catalogId": "example/shipping",
    "protocolVersion": "1.0",
    "components": {
      "DeliveryBadge": {
        "type": "object",
        "properties": {
          "component": {"const": "DeliveryBadge"},
          "label": {"type": "string"}
        },
        "required": ["component", "label"]
      }
    }
  },
  "create": {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "shipment",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
      "components": [
        {"id": "root", "component": "Column", "children": ["destination"]},
        {"id": "destination", "component": "Text", "text": "London"}
      ]
    }
  },
  "update": {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "shipment",
      "components": [
        {"id": "root", "component": "Column", "children": ["destination", "delivery"]},
        {"id": "delivery", "component": "DeliveryBadge", "@catalogId": "example/shipping", "label": "Express delivery"}
      ]
    }
  }
}
