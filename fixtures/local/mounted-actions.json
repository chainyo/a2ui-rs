{
  "version": "1.0",
  "createSurface": {
    "surfaceId": "shipments",
    "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
    "dataModel": {
      "shipments": [
        {"name": "London", "message": "Requested London shipment", "saved": false},
        {"name": "Bristol", "message": "Requested Bristol shipment", "saved": false}
      ]
    },
    "components": [
      {"id": "root", "component": "Column", "children": {"componentId": "request", "path": "/shipments"}},
      {
        "id": "request",
        "component": "Button",
        "child": "label",
        "action": {
          "event": {
            "name": "requestShipment",
            "context": {"shipment": {"@path": "name"}},
            "userMessage": {"@path": "message"}
          }
        }
      },
      {"id": "label", "component": "Text", "text": {"@path": "name"}}
    ]
  }
}
