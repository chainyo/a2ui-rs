{
  "catalog": {
    "protocolVersion": "1.0",
    "catalogId": "example:checkout",
    "components": {
      "Stack": {
        "type": "object",
        "properties": {
          "component": {"const": "Stack"},
          "slots": {"type": "array", "items": {"$ref": "common_types.json#/$defs/ComponentId"}}
        },
        "required": ["component", "slots"],
        "allowedChildren": ["Summary"]
      },
      "Summary": {
        "type": "object",
        "properties": {
          "component": {"const": "Summary"},
          "text": {"type": "string"}
        },
        "required": ["component", "text"],
        "allowedParents": ["Stack"]
      }
    }
  },
  "partnerCatalog": {
    "protocolVersion": "1.0",
    "catalogId": "example:payments",
    "components": {
      "Summary": {
        "type": "object",
        "properties": {
          "component": {"const": "Summary"},
          "approved": {"type": "boolean"}
        },
        "required": ["component", "approved"],
        "allowedParents": ["Stack"]
      }
    }
  },
  "messages": [
    {"version": "1.0", "createSurface": {"surfaceId": "checkout", "catalogId": "example:checkout", "components": [
      {"id": "root", "component": "Stack", "slots": ["summary"]},
      {"id": "summary", "component": "Summary", "text": "Order total"}
    ]}},
    {"version": "1.0", "updateComponents": {"surfaceId": "checkout", "components": [
      {"id": "summary", "component": "Summary", "text": "New total"},
      {"id": "root", "component": "Stack", "slots": ["summary", "missing"]}
    ]}},
    {"version": "1.0", "updateComponents": {"surfaceId": "checkout", "components": [
      {"id": "root", "component": "Stack", "slots": ["summary", "payment"]},
      {"id": "payment", "component": "Stack", "slots": []}
    ]}},
    {"version": "1.0", "updateComponents": {"surfaceId": "checkout", "components": [
      {"id": "summary", "component": "Summary", "text": false}
    ]}},
    {"version": "1.0", "updateComponents": {"surfaceId": "checkout", "components": [
      {"id": "summary", "component": "Summary", "@catalogId": "example:payments", "approved": true}
    ]}},
    {"version": "1.0", "updateComponents": {"surfaceId": "checkout", "components": [
      {"id": "summary", "component": "Summary", "approved": false}
    ]}}
  ]
}
